{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Baseline capabilities for the main window. Sidecar/shell scopes for ACP agents are granted per-provider.",
  "windows": ["main"],
  "permissions": ["core:default", "core:window:allow-set-focus", "core:window:allow-unminimize", "shell:default", "dialog:default", "notification:default", "updater:default", "process:default", "google-auth:default"]
}
