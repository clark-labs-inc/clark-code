{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clark Code Dev",
  "version": "0.1.129",
  "identifier": "com.clark.desktop.dev",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "corepack pnpm@10 --dir ../app dev",
    "beforeBuildCommand": "corepack pnpm@10 --dir ../app build",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "Clark Code Dev",
        "width": 1320,
        "height": 860,
        "minWidth": 920,
        "minHeight": 600,
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDODUxRkExNzUyOEFEOTAKUldTUXJTaDFvUitGL0JNREFidWw4WkIvWXRaaEU0QzZIVlIzekVMV0hqRStyaFBBYUxEZStHd3IK",
      "endpoints": [
        "https://downloads.clarkchat.com/desktop/latest/updater/{{target}}-{{arch}}.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["clark"]
      }
    }
  }
}
