{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clark Desktop",
  "version": "0.1.1",
  "identifier": "com.clark.desktop",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --dir ../app dev",
    "beforeBuildCommand": "pnpm --dir ../app build"
  },
  "app": {
    "windows": [
      {
        "title": "Clark Desktop",
        "width": 1320,
        "height": 860,
        "minWidth": 920,
        "minHeight": 600,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
