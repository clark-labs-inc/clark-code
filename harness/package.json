{
  "name": "clark-desktop-harness",
  "private": true,
  "type": "module",
  "scripts": {
    "test:webkit": "node webkit-smoke.mjs",
    "test:attachments": "node attachment-smoke.mjs",
    "test:feature-map": "node feature-matrix.mjs --validate-only",
    "test:feature-simulation": "node feature-matrix.mjs --offline",
    "test:feature-paid": "node feature-matrix.mjs --live-only",
    "test:security-ui": "node security-ui-smoke.mjs",
    "test:full-gui": "node full-gui-smoke.mjs",
    "test:specialists-ui": "node specialist-ui-smoke.mjs",
    "test:security-simulation": "node security-simulation.mjs --offline",
    "test:security-paid": "node security-simulation.mjs --paid --live-only",
    "test:utm-harness": "node --test utm-real-use.spec.mjs",
    "test:utm-autonomy": "node --test utm-real-use.spec.mjs",
    "test:platform-real-use": "node --test platform-real-use.spec.mjs",
    "test:public-release": "node --test public-release-journey.spec.mjs",
    "test:macos-product": "node --test macos-product-journey.spec.mjs",
    "test:clark-tui-product": "node --test clark-tui-product.spec.mjs",
    "test:release-preflight": "node --test release-environment-preflight.spec.mjs",
    "benchmark:clark-tui-product": "node clark-tui-product.mjs --out ../target/clark-tui-product/current.json",
    "benchmark:utm-preflight": "node utm-real-use.mjs --allow-blocked",
    "benchmark:utm-autonomy": "node utm-autonomy.mjs ensure --platform all",
    "benchmark:utm-observe": "node utm-window-observation.mjs --platform all",
    "benchmark:utm-stage-source": "node utm-source-stage.mjs stage --platform all",
    "benchmark:utm-provision": "node utm-guest-provision.mjs ensure --platform all",
    "benchmark:utm-guest-offline": "node utm-guest-benchmark.mjs run --offline --platform all",
    "benchmark:download-windows-candidate": "node download-release-candidate.mjs",
    "benchmark:windows-update-candidate": "node windows-update-candidate.mjs",
    "benchmark:windows-install": "node utm-windows-release-install.mjs",
    "benchmark:windows-release-journey": "node utm-windows-release-journey.mjs",
    "benchmark:windows-update-journey": "node utm-windows-update-journey.mjs",
    "benchmark:windows-post-publish": "node utm-windows-post-publish-journey.mjs",
    "benchmark:windows-native-containment": "node windows-native-containment.mjs",
    "benchmark:windows-auth": "node utm-windows-journey.mjs auth-smoke",
    "benchmark:ubuntu-auth": "node utm-ubuntu-journey.mjs auth-smoke",
    "benchmark:macos-auth": "node macos-product-journey.mjs auth-smoke",
    "benchmark:platform-real-use": "node platform-real-use.mjs",
    "benchmark:clark-code": "bash ../scripts/run-pre-release-benchmarks.sh",
    "benchmark:clark-code:offline": "bash ../scripts/run-pre-release-benchmarks.sh --offline",
    "benchmark:resilience": "node resilience-benchmark.mjs",
    "benchmark:resilience:smoke": "node resilience-benchmark.mjs --smoke",
    "benchmark:resilience:live": "node resilience-benchmark.mjs --live-only"
  },
  "dependencies": {
    "playwright": "^1.62.1"
  }
}
