    "consolidated_command": ["bash", "scripts/run-pre-release-benchmarks.sh"],
    "guest_receipt_flag": "--real-use-receipt",
    "complete_platform_set_required": true,
    "blocked_package_status_preserved": true,
    "vm_autonomy": {
      "required_user_vm_actions": 0,
      "manual_vm_actions_allowed": false,
      "release_requires_human_vm_action": false,
      "virtualization": "utm",
      "forbidden_virtualization": ["parallels"],
      "command": ["node", "harness/utm-autonomy.mjs", "ensure", "--platform", "all"],
      "audit_command": ["node", "harness/utm-autonomy.mjs", "audit", "--platform", "all"],
      "observation_command": ["node", "harness/utm-window-observation.mjs", "--platform", "all"],
      "credential_source": ".env",
      "credential_keys": ["CLARK_QA_VM_USERNAME", "CLARK_QA_VM_PASSWORD"],
      "credential_values_in_receipts": false,
      "guest_transport": "qemu_guest_agent_file_channel",
      "guest_probe_authentication": "per_run_random_marker",
      "qmp_bind": "127.0.0.1",
      "qmp_scope": "bootstrap_wake_and_recovery_only",
      "physical_input": "optional_non_release_diagnostic_only",
      "rule": "Provisioning, OS installation, login, guest-agent bootstrap, recovery, scenario execution, and evidence capture are harness-owned. A manual VM step is a benchmark failure, never a user instruction."
    },
    "rule": "Environment readiness never counts as a real feature or user-journey pass. Each scenario requires a guest-produced receipt with complete fresh observations, assertions, and SHA-256-pinned evidence. The cheapest supported paid tool-calling route is the default after evidence preflight; --offline cannot produce a complete real-use pass."
