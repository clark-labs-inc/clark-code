    "guest_product_commands": {
      "windows": ["node", "harness/utm-windows-journey.mjs", "auth-smoke"],
      "ubuntu": ["node", "harness/utm-ubuntu-journey.mjs", "auth-smoke"]
    },
    "guest_qa_auth": {
      "credential_source": ".env",
      "required_email_domain": "clarkslabs.com",
      "session_kind": "short_lived_jwt",
      "provider_key_binding": "same_account",
      "transient_secret_transfer_erased": true,
      "credential_values_in_receipts": false
