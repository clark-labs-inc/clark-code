  "real_use_scenarios": {
    "macos": [
      {
        "id": "mac_app_startup_auth_and_project",
        "covers": [
          "cloud_auth_history_sync_and_share",
          "conversation_streaming_and_control",
          "git_changes_checkpoints_and_worktrees",
          "cheapest_paid_live_chat_and_job_round_trip",
          "planning",
          "persistent_goals",
          "effect_verification",
          "external_research",
          "deferred_tool_discovery",
          "skills",
          "durable_memory",
          "organization_knowledge",
          "bounded_orchestration",
          "scout_system_cartography",
          "mcp_and_remote_ssh"
        ],
        "expected": "Signed Clark Code Dev starts, retains its TCC identity, opens a disposable project, completes a names-only Scout census, and completes managed Qwen 3.7 Flash chat and job turns."
      },
      {
        "id": "mac_computer_use_safety",
        "covers": [
          "computer_use_perception",
          "computer_use_prepare_commit",
          "permissions_and_sandbox",
          "android_emulator",
          "ios_simulator"
        ],
        "expected": "A fresh observation drives routine actions in a disposable TextEdit document; stale, forged, sensitive, and takeover cases fail closed; Stop quiesces before acknowledgement."
      },
      {
        "id": "mac_terminal_browser_attachments",
        "covers": [
          "integrated_terminal",
          "browser_automation",
          "attachments_artifacts_and_previews",
          "filesystem_read_search",
          "filesystem_mutation",
          "shell_process_lifecycle",
          "document_conversion",
          "image_generation",
          "updates_packaging_and_single_instance"
        ],
        "expected": "Terminal lifecycle, localhost browser navigation, and a disposable attachment render without console or projection errors."
      }
    ],
    "windows": [
      {
        "id": "windows_clean_start_and_sandbox",
        "covers": [
          "updates_packaging_and_single_instance",
          "permissions_and_sandbox",
          "integrated_terminal",
          "shell_process_lifecycle",
          "conversation_streaming_and_control"
        ],
        "expected": "Windows build starts in the UTM VM, the restricted-token/UAC state is visible, and shell cancellation leaves no child process."
      },
      {
        "id": "windows_paid_model_and_project_tools",
        "covers": [
          "cheapest_paid_live_chat_and_job_round_trip",
          "filesystem_read_search",
          "filesystem_mutation",
          "git_changes_checkpoints_and_worktrees",
          "planning",
          "persistent_goals",
          "effect_verification",
          "document_conversion",
          "external_research",
          "deferred_tool_discovery",
          "skills",
          "durable_memory",
          "image_generation",
          "organization_knowledge",
          "bounded_orchestration",
          "scout_system_cartography",
          "cloud_auth_history_sync_and_share"
        ],
        "expected": "The managed Qwen 3.7 Flash route reads and Scouts a disposable fixture without secret values, performs one approved edit, verifies the diff, and never escapes the fixture."
      },
      {
        "id": "windows_platform_exclusions",
        "covers": [
          "ios_simulator",
          "computer_use_perception",
          "computer_use_prepare_commit",
          "android_emulator",
          "browser_automation",
          "attachments_artifacts_and_previews",
          "mcp_and_remote_ssh"
        ],
        "expected": "iOS and native computer use are not advertised; the deterministic computer-use simulator still passes its contract lane."
      }
    ],
    "ubuntu": [
      {
        "id": "ubuntu_install_and_desktop_start",
        "covers": [
          "updates_packaging_and_single_instance",
          "cloud_auth_history_sync_and_share",
          "conversation_streaming_and_control",
          "planning",
          "persistent_goals",
          "skills",
          "durable_memory",
          "organization_knowledge",
          "bounded_orchestration"
        ],
        "expected": "The UTM Ubuntu VM boots into a graphical desktop with the UTM guest agent and SPICE integration, launches Clark Code, and preserves an ordinary GUI session across restart."
      },
      {
        "id": "ubuntu_paid_model_and_bubblewrap",
        "covers": [
          "cheapest_paid_live_chat_and_job_round_trip",
          "permissions_and_sandbox",
          "shell_process_lifecycle",
          "filesystem_read_search",
          "filesystem_mutation",
          "git_changes_checkpoints_and_worktrees",
          "effect_verification",
          "document_conversion",
          "external_research",
          "deferred_tool_discovery",
          "image_generation",
          "integrated_terminal",
          "scout_system_cartography"
        ],
        "expected": "The managed Qwen 3.7 Flash route reads and Scouts a disposable fixture without secret values, and bubblewrap confines an approved mutation and cancelled background process."
      },
      {
        "id": "ubuntu_feature_surface",
        "covers": [
          "browser_automation",
          "attachments_artifacts_and_previews",
          "mcp_and_remote_ssh",
          "computer_use_perception",
          "computer_use_prepare_commit",
          "android_emulator",
          "ios_simulator"
        ],
        "expected": "Linux-supported surfaces work in the GUI; native computer use is explicitly unavailable while its simulator remains green."
      }
    ]
