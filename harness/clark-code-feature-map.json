{
  "schema_version": 2,
  "product": "Clark Code",
  "live_model": {
    "id": "clark-code:free",
    "label": "Qwen 3.7 Flash",
    "upstream_id": "qwen/qwen3.7-flash",
    "provider": "clark-platform",
    "base_url": "https://api.clarkslabs.com/v1",
    "credential": "CLARK_CODE_API_KEY",
    "default_paid": true,
    "selection_policy": "lowest_expected_cost_for_input_heavy_tool_calling_tests",
    "pricing_snapshot": {
      "as_of": "2026-07-28",
      "source": "https://openrouter.ai/api/v1/models",
      "input_usd_per_million_tokens": 0.03,
      "output_usd_per_million_tokens": 0.13,
      "cached_input_usd_per_million_tokens": 0.006
    },
    "offline_flag": "--offline",
    "max_live_tests": 3,
    "max_iterations_per_turn": 16,
    "temperature": 0.0,
    "inter_test_cost_ceiling_usd": 0.5,
    "rule": "The consolidated benchmark uses the managed Qwen 3.7 Flash lane by default. --offline is the explicit opt-out. Credentials must never be printed or persisted."
  },
  "platforms": ["macos", "windows", "ubuntu"],
  "support_states": [
    "supported",
    "simulated",
    "platform_specific",
    "unsupported"
  ],
  "test_lanes": {
    "frontend_contract": {
      "kind": "simulated",
      "platforms": ["macos", "windows", "ubuntu"],
      "steps": [
        ["corepack", "pnpm@10", "--dir", "app", "typecheck"],
        ["corepack", "pnpm@10", "--dir", "app", "test"],
        ["corepack", "pnpm@10", "--dir", "app", "build"]
      ]
    },
    "rust_contract": {
      "kind": "simulated",
      "platforms": ["macos", "windows", "ubuntu"],
      "steps": [
        ["cargo", "test", "-p", "agent-core", "-p", "provider-acp", "-p", "provider-clark", "-p", "provider-local"]
      ]
    },
    "computer_use_contract": {
      "kind": "simulated",
      "platforms": ["macos", "windows", "ubuntu"],
      "macos_dyld_swift_runtime": true,
      "steps": [
        ["cargo", "test", "-p", "computer-use", "--features", "helper-service"],
        ["cargo", "test", "-p", "provider-local", "--test", "computer_use"]
      ]
    },
    "sandbox_contract": {
      "kind": "simulated",
      "platforms": ["macos", "windows", "ubuntu"],
      "steps": [
        ["cargo", "test", "-p", "exec-core", "-p", "exec-sandbox", "-p", "exec-sandbox-windows"]
      ]
    },
    "webkit_contract": {
      "kind": "simulated",
      "platforms": ["macos"],
      "steps": [
        ["corepack", "pnpm@10", "--dir", "harness", "test:webkit"]
      ]
    },
    "attachment_contract": {
      "kind": "simulated",
      "platforms": ["macos"],
      "steps": [
        ["corepack", "pnpm@10", "--dir", "harness", "test:attachments"]
      ]
    },
    "resilience_contract": {
      "kind": "simulated",
      "platforms": ["macos", "windows", "ubuntu"],
      "steps": [
        ["corepack", "pnpm@10", "--dir", "harness", "benchmark:resilience:smoke"]
      ]
    },
    "utm_harness_contract": {
      "kind": "simulated",
      "platforms": ["macos"],
      "steps": [
        ["node", "--test", "harness/utm-real-use.spec.mjs"]
      ]
    },
    "platform_real_use_contract": {
      "kind": "simulated",
      "platforms": ["macos", "windows", "ubuntu"],
      "steps": [
        ["node", "--test", "harness/platform-real-use.spec.mjs"]
      ]
    },
    "cheapest_paid_live_chat_jobs": {
      "kind": "live_paid",
      "platforms": ["macos", "windows", "ubuntu"],
      "steps": [
        [
          "cargo",
          "test",
          "-p",
          "provider-local",
          "--test",
          "live_clark_code",
          "live_clark_code_skills_end_to_end",
          "--",
          "--ignored",
          "--exact",
          "--nocapture",
          "--test-threads=1"
        ],
        [
          "cargo",
          "test",
          "-p",
          "provider-local",
          "--test",
          "live_clark_code",
          "live_clark_code_feature_matrix",
          "--",
          "--ignored",
          "--exact",
          "--nocapture",
          "--test-threads=1"
        ],
        [
          "cargo",
          "test",
          "-p",
          "provider-local",
          "--test",
          "live_clark_code",
          "live_clark_code_compacts_and_continues",
          "--",
          "--ignored",
          "--exact",
          "--nocapture",
          "--test-threads=1"
        ]
      ]
    }
  },
