# Copy to .env.local (gitignored) and fill in. No secrets are committed.

# Google sign-in (real Clark Better Auth).
# Clark web origin hosting Better Auth + the /desktop-auth handoff page. The
# gateway WS endpoint for Google-authed users is derived from this (https→wss,
# +/ws). Defaults to production; set to https://dev.clarkslabs.com for dev.
CLARK_AUTH_ORIGIN=https://www.clarkchat.com

# Native (Tauri) only — the "Desktop app" Google OAuth client. The secret is a
# non-confidential installed-app secret (embedded in the app), not a server
# secret. The Clark backend must also trust this client id's audience via
# GOOGLE_DESKTOP_CLIENT_ID, and Google Cloud must allow http://localhost as a
# redirect URI for this client.
CLARK_GOOGLE_DESKTOP_CLIENT_ID=
CLARK_GOOGLE_DESKTOP_CLIENT_SECRET=
