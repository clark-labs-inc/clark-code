# Rust
/target
**/target

# Local-only cargo overrides (e.g. developing against a sibling clark-agent
# checkout). Never committed — CI resolves the pinned git deps instead.
.cargo/config.toml

# Node / frontend
node_modules
app/dist
app/node_modules
*.tsbuildinfo
__pycache__/
/harness/test-results/

# Tauri generated
src-tauri/gen
src-tauri/icon-source.png
# Release-only sidecars are fetched from the pinned manifest in CI.
src-tauri/binaries/

# Env / secrets — never commit
.env
.env.*
!.env.example
*.local

# OS / editor
.DS_Store
.idea
.vscode/*
!.vscode/extensions.json

# Demo recordings (local only)
videos/

# Local QA, prototypes, marketing exports, and screen-capture output — never
# commit generated or machine-specific evidence here.
.test-ui-screenshots/
design-qa-local/
.design-qa/
design-qa/
app/src/prototypes/
promos/
prototypes/
.codex/
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
credentials.json
service-account*.json

# Agent local state (memory, scratch screenshots) — never committed
.claude/
.agent/
.clark/
